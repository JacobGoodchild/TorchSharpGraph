<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TorchSharp-cpu" Version="0.107.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inside this repository the sample uses the library's source. In your own project:
         dotnet add package TorchSharpGraph -->
    <ProjectReference Include="..\..\dotnet\src\TorchSharpGraph\TorchSharpGraph.csproj" />
  </ItemGroup>

</Project>
